generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Di Prisma v5, cara ini LEGAL dan PASTI JALAN
  url      = "postgresql://user_admin:password_rahasia@localhost:5433/expense_db?schema=public"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?
  expenses Expense[]
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String   // Judul: misal "Makan Siang"
  amount      Int      // Nominal: misal 15000
  category    String   // Kategori: misal "Food", "Transport"
  date        DateTime @default(now()) // Tanggal transaksi
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachment String?

  // Kunci Asing (Foreign Key) untuk menghubungkan ke User
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}