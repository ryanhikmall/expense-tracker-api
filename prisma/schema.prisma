generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Di Prisma v5, cara ini LEGAL dan PASTI JALAN
  url      = "postgresql://user_admin:password_rahasia@localhost:5433/expense_db?schema=public"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String?
}